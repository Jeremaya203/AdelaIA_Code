# Copiar a .env (nunca commitear el .env con llaves reales).
# Las llaves viven solo aquí; config.py las lee del entorno.
GROQ_API_KEY=
JINA_API_KEY=
# Modelo primario y fallback (IDs verificados en docs de Groq 2026-09-07).
# Sin degradación a 20B por decisión del autor (2026-09-09): ver config.py.
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
# Orígenes permitidos por CORS (coma-separados).
CORS_ORIGINS=http://localhost:5173
# Persistencia de Chroma y colección.
# Colección operativa verificada 2026-09-13 (2641 fragmentos, dim 1024).
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=adelaia_operativo
# Documentos del operativo (rutas relativas a la raíz del repo, coma-separados).
# Lista canónica = app/backend/.env del autor (18 fuentes, 2026-09-13).
# El rango PRG#190-230 limita la ingesta al bloque de socialización.
PILOT_DOCS=tesis/bibliografia/corpus_a/Ley_388_1997.pdf,tesis/bibliografia/corpus_a/Ley_9_1989.pdf,tesis/bibliografia/corpus_a/Decreto_1420_1998.pdf,tesis/bibliografia/corpus_a/Ley_1437_2011_CPACA.pdf,tesis/bibliografia/corpus_a/AP-DR-002_Politica_Reasentamiento_PLMB_V01.pdf,tesis/bibliografia/corpus_c/prg_l2mb_may2024.pdf#190-230,tesis/bibliografia/corpus_f/aviso_desierta_l2mb_2026-01-20.pdf,tesis/bibliografia/corpus_f/acta_cierre_precalificacion_l2mb_2026_OCR.pdf,tesis/bibliografia/corpus_f/precalificacion_l2mb_2026-03-06.pdf,tesis/bibliografia/corpus_f/cronograma_emb_2026.pdf,tesis/bibliografia/corpus_f/diagnostico_predial_estaciones/EST 7 2LMB FINAL.pdf,tesis/bibliografia/corpus_f/diagnostico_predial_estaciones/EST 8 2LMB FINAL.pdf,tesis/bibliografia/corpus_f/diagnostico_predial_estaciones/EST 9 2LMB FINAL.pdf,tesis/bibliografia/corpus_f/diagnostico_predial_estaciones/MATRIZ DE DECISIÓN PREDIAL FINAL.pdf,tesis/bibliografia/corpus_a/Ley_1564_2012_CGP.pdf,tesis/bibliografia/corpus_a/Ley_1682_2013.pdf,tesis/bibliografia/corpus_a/Ley_1742_2014.pdf,tesis/bibliografia/corpus_a/Ley_1882_2018.pdf
TOP_K=6
# Tope de consultas por minuto e IP (regla 45: sin límite no hay red abierta).
RATE_LIMIT_PER_MINUTE=30
